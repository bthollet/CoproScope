    "derivative_max_college": { "type": "string" },
    "publication_form": { "type": "string" },
    "restriction_reasons": { "type": "string" },
    "personal_data_level": { "type": "string" },
    "ip_status": { "type": "string" },
    "ai_processing_ceiling": { "type": "string" },
    "review_required": { "type": "string" },
    "policy_confidence": { "type": "string" },
    "required_transformations": { "type": "string" },
    "screening_signals": { "type": "string" },
    "privacy_review_status": { "type": "string" },
    "redaction_status": { "type": "string" },
    "redaction_mode": { "type": "string" },
    "redacted_path": { "type": "string" },
    "redacted_sha256": { "type": "string" },
    "redaction_map_id": { "type": "string" }
