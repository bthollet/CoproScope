    "scope": { "type": "string" },
    "sha256": { "type": "string" },
    "original_path": { "type": "string" },
    "file_name": { "type": "string" },
    "document_type": { "type": "string" },
    "lot": { "type": "string" },
    "status_ocr": { "type": "string" },
    "classification_status": { "type": "string" },
    "extraction_level": { "type": "string" },
    "text_quality": { "type": "string" },
    "ocr_engine": { "type": "string" },
    "docling_path": { "type": "string" },
    "layout_path": { "type": "string" },
    "ai_review_status": { "type": "string" },
    "sensitivity": { "type": "string" },
    "raw_max_college": {
      "type": "string",
      "enum": [
        "C0_Public",
        "C1_Occupants_Usagers",
        "C2_Coproprietaires",
        "C3_Coproprietaire_Concerne",
        "C4_Conseil_Syndical",
        "C5_Syndic_Admin",
        "C6_Prestataire_Mandate",
        "C7_Contentieux_Secret",
        "C8_Restreint_Critique"
