{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoproScope Instance",
  "type": "object",
  "required": ["version", "instance_id", "display_name", "roots", "registers"],
  "properties": {
    "version": { "type": ["string", "number"] },
    "instance_id": { "type": "string" },
    "display_name": { "type": "string" },
    "scope": { "type": "string" },
    "entity_id": { "type": "string" },
    "roots": {
      "type": "object",
      "required": ["raw", "workspace", "system", "outputs", "staging", "logs"],
      "properties": {
        "raw": { "type": "string" },
        "workspace": { "type": "string" },
        "system": { "type": "string" },
        "outputs": { "type": "string" },
        "staging": { "type": "string" },
        "logs": { "type": "string" },
        "restricted": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "registers": { "type": "object" },
    "matrices": { "type": "object" },
    "artifacts": { "type": "object" },
    "env": { "type": "object" },
    "settings": { "type": "object" }
  }
}
