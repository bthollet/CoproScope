# Keep repository text diffs stable across Windows and CI.
* text=auto eol=lf

# Windows command wrappers are more portable with CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets and generated archives.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
*.7z binary
*.gz binary
*.sqlite binary
*.db binary
*.pyc binary
